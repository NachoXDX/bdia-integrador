# ==========================================
# PostgreSQL Database Admin Configuration
# ==========================================
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# ==========================================
# PostgreSQL Application Roles Credentials
# ==========================================
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password
AI_DB_USER=ai_agent
AI_DB_PASSWORD=ai_agent_password

# ==========================================
# pgAdmin Web Interface Configuration
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8080

# ==========================================
# MinIO Object Storage Configuration
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==========================================
# FastAPI & JWT Security Configuration
# ==========================================
FASTAPI_PORT=8000
JWT_SECRET=super_secret_jwt_key_bdia_2026

# ==========================================
# OpenRouter & LLM Natural Language to SQL
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

